r'} />)}</div><Card className="border-slate-200 bg-white text-[#0F172A] shadow-sm"><CardHeader className="flex flex-col gap-4 border-b border-slate-100 px-5 py-5 sm:flex-row sm:items-center sm:justify-between lg:px-6"><div><CardTitle className="text-base font-bold">Recent Requests &amp; Activity</CardTitle><p className="mt-1 text-xs text-slate-500">Track your latest submissions and approvals.</p></div><Tabs value={activeTab} onValueChange={setActiveTab}><TabsList className="h-9 bg-slate-100 p-1"><TabsTrigger value="all" className="px-3 text-xs text-[#475569] data-[state=active]:bg-[#0F172A] data-[state=active]:text-white">All</TabsTrigger><TabsTrigger value="leaves" className="px-3 text-xs text-[#475569] data-[state=active]:bg-[#0F172A] data-[state=active]:text-white">Leaves</TabsTrigger><TabsTrigger value="expenses" className="px-3 text-xs text-[#475569] data-[state=active]:bg-[#0F172A] data-[state=active]:text-white">Expenses</TabsTrigger></TabsList></Tabs></CardHeader><CardContent className="p-0"><div className="overflow-x-auto"><Table><TableHeader><TableRow className="bg-slate-50/70"><TableHead className="pl-5 text-[10px] font-bold uppercase tracking-wider text-slate-500">Request Type</TableHead><TableHead className="text-[10px] font-bold uppercase tracking-wider text-slate-500">Submission Date</TableHead><TableHead className="text-[10px] font-bold uppercase tracking-wider text-slate-500">Details / Duration</TableHead><TableHead className="text-[10px] font-bold uppercase tracking-wider text-slate-500">Amount / Balance</TableHead><TableHead className="text-[10px] font-bold uppercase tracking-wider text-slate-500">Status</TableHead><TableHead className="pr-5 text-right text-[10px] font-bold uppercase tracking-wider text-slate-500">Actions</TableHead></TableRow></TableHeader><TableBody>{filtered.map((item) => <TableRow key={`${item.type}-${item.date}`}><TableCell className="pl-5"><div className="flex items-center gap-3"><div className={`flex size-8 items-center justify-center rounded-lg ${item.type === 'Leave Request' ? 'bg-blue-50 text-blue-600' : 'bg-[#F7F1EC] text-[#8C6D52]'}`}><item.icon className="size-4" /></div><span className="text-xs font-semibold text-slate-700">{item.type}</span></div></TableCell><TableCell className="text-xs text-slate-500">{item.date}</TableCell><TableCell className="text-xs text-slate-600">{item.detail}</TableCell><TableCell className="text-xs font-semibold text-slate-700">{item.value}</TableCell><TableCell><StatusBadge tone={item.tone} label={item.status} /></TableCell><TableCell className="pr-5 text-right">{item.pdf ? <Button variant="ghost" size="sm" className="h-8 gap-1 text-[11px] text-slate-500"><Download className="size-3.5" /> PDF</Button> : <span className="text-xs text-slate-300">—</span>}</TableCell></TableRow>)}</TableBody></Table></div></CardContent></Card><footer className="mt-8 flex flex-col gap-2 border-t border-slate-200 pt-5 text-[11px] text-slate-400 sm:flex-row sm:items-center sm:justify-between"><span>© 2025 Silent Believers Distribution</span><span className="flex items-center gap-1"><FileText className="size-3" /> SBD-HR-PORTAL</span></footer></div><aside className="flex min-w-0 flex-col gap-4">
