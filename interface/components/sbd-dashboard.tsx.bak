// export default SbdDashboard

'use client'


import { useMemo, useState } from 'react'
import {
  Bell, BookOpen, BriefcaseBusiness, Building2, CalendarDays, Check, ChevronDown, ChevronRight,
  CircleHelp, ClipboardCheck, Clock3, Download, FileText, FolderOpen, Headphones, LayoutDashboard,
  LogOut, Menu, Newspaper, Play, Plane, ReceiptText, Search, Settings2, ShieldCheck, Sparkles,
  UsersRound, X, Zap
} from 'lucide-react'
import { Avatar, AvatarFallback } from '@/components/ui/avatar'
import { Badge } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
import { Input } from '@/components/ui/input'
import { Separator } from '@/components/ui/separator'
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table'
import { Tabs, TabsList, TabsTrigger } from '@/components/ui/tabs'

const navGroups = [
  { label: 'Personal Space', icon: LayoutDashboard, open: true, items: [['Dashboard', LayoutDashboard], ['Leave Requests', CalendarDays], ['Expense Claims', ReceiptText], ['Administrative Documents', FolderOpen]] },
  { label: 'Company Services', icon: Building2, items: [['Meeting Room Booking', Building2], ['Travel & Hotel', Plane], ['IT Helpdesk', Headphones]] },
  { label: 'Career & Growth', icon: BriefcaseBusiness, items: [['Training Catalog', BookOpen], ['Performance Reviews', ClipboardCheck], ['Internal Job Postings', BriefcaseBusiness]] },
  { label: 'Management & HR', icon: ShieldCheck, restricted: true, items: [['Team Approvals', Check], ['Maker-Checker Audit', ShieldCheck], ['Employee Directory', UsersRound]] },
] as const

const activities = [
  { type: 'Leave Request', icon: CalendarDays, date: 'Mar 18, 2025', detail: 'Annual leave · 3 days', value: '9.5 days left', status: 'Approved', tone: 'approved' },
  { type: 'Expense Claim', icon: ReceiptText, date: 'Mar 15, 2025', detail: 'Client lunch · Casablanca', value: '1,280 MAD', status: 'Pending Manager', tone: 'pending' },
  { type: 'Expense Claim', icon: ReceiptText, date: 'Mar 11, 2025', detail: 'Taxi & transit · February', value: '620 MAD', status: 'Approved', tone: 'approved', pdf: true },
  { type: 'Leave Request', icon: CalendarDays, date: 'Feb 27, 2025', detail: 'Personal leave · 1 day', value: '12.5 days left', status: 'Rejected', tone: 'rejected' },
  { type: 'Expense Claim', icon: ReceiptText, date: 'Feb 20, 2025', detail: 'Work equipment · Keyboard', value: '1,550 MAD', status: 'Pending Manager', tone: 'pending' },
]

const kpis = [
  { label: 'Leave Balance', value: '12.5', unit: '/ 18.0 days', icon: CalendarDays, accent: 'blue', note: '+1.5 days accrued monthly' },
  { label: 'Pending Expenses', value: '3,450', unit: 'MAD', icon: ReceiptText, accent: 'bronze', note: '2 claims awaiting manager approval' },
  { label: 'Action Required', value: '1', unit: 'pending review', icon: Clock3, accent: 'amber', note: 'Training evaluation form ready' },
] as const

const quickActions = [
  { label: 'Request Leave', hint: 'Annual, sick, personal', icon: CalendarDays },
  { label: 'Submit Expense', hint: 'Upload a receipt', icon: ReceiptText },
  { label: 'Book a Room', hint: 'Meeting spaces', icon: Building2 },
  { label: 'IT Ticket', hint: 'Get tech support', icon: Headphones },
] as const

const newsItems = [
  { month: 'MAR', day: '24', title: 'Annual Team Seminar — Registration Open', meta: 'Events · 2 min read' },
  { month: 'MAR', day: '20', title: 'Dress Code & Workplace Guidelines Update', meta: 'HR Policy · 3 min read' },
  { month: 'MAR', day: '14', title: 'SBD Product of the Year Milestone', meta: 'Company · 1 min read' },
  { month: 'MAR', day: '06', title: 'New Health Insurance Partner', meta: 'Benefits · 2 min read' },
] as const

const upcomingEvents = [
  { month: 'MAR', day: '28', title: 'Seminar registration closes', meta: 'Annual Team Seminar', tag: 'Deadline', tone: 'amber' },
  { month: 'MAR', day: '31', title: 'Eid al-Fitr', meta: 'Public holiday · Office closed 2 days', tag: 'Holiday', tone: 'emerald' },
  { month: 'APR', day: '02', title: 'Q2 Town Hall', meta: '10:00 · Main auditorium', tag: 'Event', tone: 'blue' },
  { month: 'APR', day: '07', title: 'Cybersecurity Awareness', meta: 'Mandatory training · 1h', tag: 'Training', tone: 'bronze' },
] as const

/* Shared card surface. `gap-0 py-0` cancels the default vertical padding/gap of newer shadcn Cards,
   which was the main source of the extra height in the right column. */
const cardSurface = 'gap-0 py-0 rounded-xl border border-slate-200/80 bg-white shadow-[0_1px_2px_rgba(15,23,42,0.04)]'
const cardHeaderRow = 'flex flex-row items-center justify-between gap-2 space-y-0 border-b border-slate-100 px-4 py-3 [.border-b]:pb-3'
const tabTrigger = 'h-7 rounded-md px-3 text-[11px] font-medium text-slate-500 data-[state=active]:bg-[#23355d] data-[state=active]:text-white data-[state=active]:shadow-sm'

export function SbdDashboard() {
  const [sidebarOpen, setSidebarOpen] = useState(true)
  const [query, setQuery] = useState('')
  const [activeTab, setActiveTab] = useState('all')
  const [updatesTab, setUpdatesTab] = useState('news')
  const [expanded, setExpanded] = useState<string[]>(['Personal Space'])
  const filtered = useMemo(() => activities.filter((item) => activeTab === 'all' || (activeTab === 'leaves' ? item.type === 'Leave Request' : item.type === 'Expense Claim')), [activeTab])

  return <div className="min-h-screen bg-[#F1F5F9] text-[#0F172A]">
    <aside className={`fixed inset-y-0 left-0 z-30 flex w-[264px] flex-col bg-[#192646] text-white transition-transform duration-200 ${sidebarOpen ? 'translate-x-0' : '-translate-x-full'}`}>
      <div className="flex items-center gap-3 border-b border-white/10 px-4 py-5"><div className="flex size-11 shrink-0 items-center justify-center rounded-xl bg-white p-1 shadow-sm">
  <img src="/logo.png" alt="Silent Believers Distribution" className="size-full object-contain" />
</div>
<div className="min-w-0"><p className="text-[11px] font-bold tracking-[0.12em] text-white">SILENT BELIEVERS</p><p className="text-[10px] tracking-[0.2em] text-blue-200">DISTRIBUTION</p></div><button aria-label="Close navigation" onClick={() => setSidebarOpen(false)} className="ml-auto rounded-md p-1 text-slate-400 hover:bg-white/10 lg:hidden"><X /></button></div>
      <nav className="flex-1 overflow-y-auto px-3 py-5">{navGroups.map((group) => { const isExpanded = expanded.includes(group.label); const GroupIcon = group.icon; return <div key={group.label} className="mb-3"><button aria-expanded={isExpanded} onClick={() => setExpanded((current) => isExpanded ? current.filter((item) => item !== group.label) : [...current, group.label])} className={`flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-[11px] font-bold uppercase tracking-[0.1em] transition-colors ${isExpanded ? 'text-white' : 'text-slate-400 hover:bg-[#5574c5] hover:text-white'}`}><GroupIcon className="size-4" /><span className="flex-1">{group.label}</span>{group.restricted && <ShieldCheck className="size-3.5" />}{isExpanded ? <ChevronDown className="size-4" /> : <ChevronRight className="size-4" />}</button>{isExpanded && <div className="mt-1 flex flex-col gap-1 pl-2">{group.items.map(([label, Icon]) => <button key={label} className={`group flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-left text-[13px] font-medium transition-colors ${label === 'Dashboard' ? 'bg-white/15 text-white hover:bg-white/20 shadow-sm shadow-blue-950/20' : 'text-slate-300 hover:bg-[#5574c5] hover:text-white'}`}><Icon className="size-[17px] shrink-0 opacity-90" /><span className="truncate">{label}</span>{label === 'Team Approvals' && <span className="ml-auto rounded-full bg-amber-400 px-1.5 py-0.5 text-[10px] font-bold text-[#0F172A]">2</span>}</button>)}</div>}</div> })}</nav>
      <div className="border-t border-white/10 p-4"><div className="flex items-center gap-3 rounded-lg bg-white/5 p-3"><Avatar className="size-9 border border-blue-300/40"><AvatarFallback className="bg-blue-100 text-xs font-bold text-blue-800">FE</AvatarFallback></Avatar><div className="min-w-0 flex-1"><p className="truncate text-xs font-semibold">Fatima E.</p><p className="truncate text-[10px] text-slate-400">Software Engineer Intern</p></div><Settings2 className="size-4 text-slate-400" /></div><button className="mt-3 flex w-full items-center gap-2 rounded-lg px-3 py-2 text-xs font-medium text-slate-400 hover:bg-[#5574c5] hover:text-white"><LogOut className="size-4" /> Log out</button></div>
    </aside>

    <div className={`transition-[margin] duration-200 ${sidebarOpen ? 'lg:ml-[264px]' : 'lg:ml-0'}`}>
      <header className="sticky top-0 z-20 flex h-[76px] items-center gap-4 border-b border-slate-200 bg-white/95 px-5 backdrop-blur lg:px-8"><button aria-label="Toggle navigation" onClick={() => setSidebarOpen(!sidebarOpen)} className="rounded-lg p-2 text-slate-500 hover:bg-slate-100"><Menu className="size-5" /></button><div className="hidden items-center gap-2 text-sm text-slate-400 md:flex"><span>Dashboard</span><ChevronRight className="size-3.5" /><span className="font-semibold text-[#0F172A]">Overview</span></div><div className="relative ml-auto w-full max-w-[440px] lg:mx-auto"><Search className="absolute left-3 top-1/2 size-4 -translate-y-1/2 text-slate-400" /><Input value={query} onChange={(e) => setQuery(e.target.value)} placeholder="Search colleagues by name, email, or department..." className="h-10 border-slate-200 bg-slate-50 pl-10 text-xs shadow-none" />{query && <div className="absolute top-12 z-20 w-full rounded-xl border border-slate-200 bg-white p-3 shadow-xl"><p className="text-xs font-semibold">Youssef Amrani</p><p className="text-[11px] text-slate-500">Engineering · youssef.amrani@sbd.ma</p></div>}</div><div className="hidden items-center gap-5 sm:flex"><button className="relative rounded-lg p-2 text-slate-500"><Bell className="size-[19px]" /><span className="absolute right-0.5 top-0.5 flex size-4 items-center justify-center rounded-full bg-[#23355d] text-[9px] font-bold text-white ring-2 ring-white">3</span></button><button className="flex items-center gap-1.5 text-xs font-medium text-slate-500"><CircleHelp className="size-4" /> Help</button><Avatar className="size-9 border border-slate-200"><AvatarFallback className="bg-[#0F172A] text-xs font-bold text-white">FE</AvatarFallback></Avatar></div></header>

      <main className="mx-auto grid max-w-[1600px] gap-5 px-5 py-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:px-8 lg:py-7">
        {/* ───────────── Main column ───────────── */}
        <div className="flex min-w-0 flex-col">
          <div className="mb-5">
            <h1 className="text-2xl font-bold tracking-tight text-[#192646]">Dashboard</h1>
            <p className="mt-1 text-sm text-slate-500">Overview of your requests, balance, and company updates.</p>
          </div>

          {/* Welcome banner — minimal */}
          <Card className={`${cardSurface} mb-5 overflow-hidden bg-gradient-to-r from-white via-white to-[#F7F1EC]/70`}>
            <CardContent className="flex items-center gap-4 p-5">
              <div className="flex size-11 shrink-0 items-center justify-center rounded-xl bg-[#F7F1EC] text-[#8C6D52] ring-1 ring-[#D7C4B7]/60"><Sparkles className="size-5" /></div>
              <div>
                <h2 className="text-base font-semibold text-[#192646]">Welcome back, Fatima</h2>
                <p className="mt-0.5 text-[13px] text-slate-500">Here&apos;s what&apos;s happening across your workspace today.</p>
              </div>
            </CardContent>
          </Card>

          <div className="mb-5 grid gap-4 md:grid-cols-3">
            {kpis.map((kpi) => <KpiCard key={kpi.label} {...kpi} />)}
          </div>

          <Card className={`${cardSurface} overflow-hidden text-[#0F172A]`}>
            <CardHeader className="flex flex-col gap-3 space-y-0 border-b border-slate-100 px-5 py-4 sm:flex-row sm:items-center sm:justify-between [.border-b]:pb-4">
              <div>
                <CardTitle className="text-[15px] font-semibold text-[#192646]">Recent Requests &amp; Activity</CardTitle>
                <p className="mt-0.5 text-xs text-slate-500">Track your latest submissions and approvals.</p>
              </div>
              <Tabs value={activeTab} onValueChange={setActiveTab}>
                <TabsList className="h-9 rounded-lg bg-slate-100 p-1">
                  <TabsTrigger value="all" className={tabTrigger}>All</TabsTrigger>
                  <TabsTrigger value="leaves" className={tabTrigger}>Leaves</TabsTrigger>
                  <TabsTrigger value="expenses" className={tabTrigger}>Expenses</TabsTrigger>
                </TabsList>
              </Tabs>
            </CardHeader>
            <CardContent className="p-0">
              <div className="overflow-x-auto">
                <Table>
                  <TableHeader>
                    <TableRow className="border-slate-100 bg-slate-50/80 hover:bg-slate-50/80">
                      <TableHead className="h-10 pl-5 text-[10px] font-semibold uppercase tracking-wider text-slate-400">Request Type</TableHead>
                      <TableHead className="h-10 text-[10px] font-semibold uppercase tracking-wider text-slate-400">Submitted</TableHead>
                      <TableHead className="h-10 text-[10px] font-semibold uppercase tracking-wider text-slate-400">Details / Duration</TableHead>
                      <TableHead className="h-10 text-[10px] font-semibold uppercase tracking-wider text-slate-400">Amount / Balance</TableHead>
                      <TableHead className="h-10 text-[10px] font-semibold uppercase tracking-wider text-slate-400">Status</TableHead>
                      <TableHead className="h-10 pr-5 text-right text-[10px] font-semibold uppercase tracking-wider text-slate-400">Actions</TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    {filtered.map((item) => (
                      <TableRow key={`${item.type}-${item.date}`} className="group border-slate-100 transition-colors hover:bg-[#F7F1EC]/40">
                        <TableCell className="py-3 pl-5">
                          <div className="flex items-center gap-3">
                            <div className={`flex size-8 items-center justify-center rounded-lg ring-1 ${item.type === 'Leave Request' ? 'bg-blue-50 text-blue-600 ring-blue-100' : 'bg-[#F7F1EC] text-[#8C6D52] ring-[#D7C4B7]/50'}`}><item.icon className="size-4" /></div>
                            <span className="text-[13px] font-medium text-slate-800">{item.type}</span>
                          </div>
                        </TableCell>
                        <TableCell className="py-3 text-xs tabular-nums text-slate-500">{item.date}</TableCell>
                        <TableCell className="py-3 text-xs text-slate-600">{item.detail}</TableCell>
                        <TableCell className="py-3 text-[13px] font-semibold tabular-nums text-[#192646]">{item.value}</TableCell>
                        <TableCell className="py-3"><StatusBadge tone={item.tone} label={item.status} /></TableCell>
                        <TableCell className="py-3 pr-5 text-right">
                          {item.pdf
                            ? <Button variant="ghost" size="sm" className="h-7 gap-1 rounded-md px-2 text-[11px] font-medium text-[#23355d] hover:bg-[#23355d]/10 hover:text-[#23355d]"><Download className="size-3.5" /> PDF</Button>
                            : <span className="text-xs text-slate-300">—</span>}
                        </TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              </div>
            </CardContent>
          </Card>
        </div>

        {/* ───────────── Right column (condensed) ───────────── */}
        <aside className="flex min-w-0 flex-col gap-4">
          <div className="relative flex aspect-video flex-col justify-between overflow-hidden rounded-xl bg-gradient-to-br from-[#192646] via-[#1E3A5F] to-[#23355d] p-4 text-white shadow-sm">
            <div className="flex items-center justify-between">
              <span className="rounded bg-white/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.14em] text-blue-200">Corporate highlight</span>
              <span className="text-[10px] text-slate-300">2 min</span>
            </div>
            <button aria-label="Play Message" className="flex size-10 items-center justify-center self-center rounded-full bg-white text-[#23355d] shadow-lg ring-4 ring-white/15 transition-transform hover:scale-105">
              <Play className="ml-0.5 size-4 fill-current" />
            </button>
            <div>
              <h2 className="text-sm font-semibold leading-tight text-white">Message from General Management</h2>
              <p className="mt-0.5 line-clamp-1 text-[11px] text-slate-300">Priorities, culture, and the year ahead.</p>
            </div>
          </div>

          <Card className={cardSurface}>
            <CardHeader className={cardHeaderRow}>
              <div className="flex items-center gap-2"><Zap className="size-4 text-[#8C6D52]" /><CardTitle className="text-sm font-semibold text-[#192646]">Quick Actions</CardTitle></div>
            </CardHeader>
            <CardContent className="grid grid-cols-2 gap-2 p-3">
              {quickActions.map(({ label, hint, icon: Icon }) => (
                <button key={label} type="button" className="group flex items-center gap-2.5 rounded-lg border border-slate-200/80 bg-slate-50/60 p-2.5 text-left transition-all hover:border-[#23355d]/25 hover:bg-white hover:shadow-sm">
                  <span className="flex size-7 shrink-0 items-center justify-center rounded-md bg-white text-[#23355d] ring-1 ring-slate-200 transition-colors group-hover:bg-[#23355d] group-hover:text-white group-hover:ring-[#23355d]"><Icon className="size-3.5" /></span>
                  <span className="min-w-0">
                    <span className="block truncate text-[11px] font-semibold text-slate-800">{label}</span>
                    <span className="block truncate text-[10px] text-slate-400">{hint}</span>
                  </span>
                </button>
              ))}
            </CardContent>
          </Card>

          {/* News + Upcoming merged into one tabbed card.
              flex-1 lets it stretch so the sidebar ends exactly where the table ends (desktop). */}
          <Card className={`${cardSurface} flex-1`}>
            <CardHeader className={cardHeaderRow}>
              <div className="flex items-center gap-2"><Newspaper className="size-4 text-[#8C6D52]" /><CardTitle className="text-sm font-semibold text-[#192646]">Updates</CardTitle></div>
              <Tabs value={updatesTab} onValueChange={setUpdatesTab}>
                <TabsList className="h-8 rounded-lg bg-slate-100 p-0.5">
                  <TabsTrigger value="news" className={`${tabTrigger} h-7 px-2.5`}>News</TabsTrigger>
                  <TabsTrigger value="upcoming" className={`${tabTrigger} h-7 px-2.5`}>Upcoming</TabsTrigger>
                </TabsList>
              </Tabs>
            </CardHeader>
            <CardContent className="flex flex-1 flex-col p-2">
              {updatesTab === 'news'
                ? newsItems.map((item) => <NewsItem key={item.title} {...item} />)
                : upcomingEvents.map((event) => <EventItem key={event.title} {...event} />)}
              <button type="button" className="mt-auto flex items-center justify-center gap-1 rounded-md py-2 text-[11px] font-semibold text-[#23355d] transition-colors hover:bg-slate-50">
                {updatesTab === 'news' ? 'All announcements' : 'Open calendar'} <ChevronRight className="size-3.5" />
              </button>
            </CardContent>
          </Card>

        </aside>

        {/* Footer spans both columns so the table and sidebar end on the same line */}
        <footer className="flex flex-col gap-2 border-t border-slate-200 pt-4 text-[11px] text-slate-400 sm:flex-row sm:items-center sm:justify-between lg:col-span-2"><span>© 2025 Silent Believers Distribution</span><span className="flex items-center gap-1"><FileText className="size-3" /> SBD-HR-PORTAL</span></footer>
      </main>
    </div>
  </div>
}

function DateTile({ month, day }: { month: string; day: string }) {
  return <div className="flex w-10 shrink-0 flex-col items-center rounded-md border border-[#D7C4B7]/70 bg-[#F7F1EC] py-1">
    <span className="text-[8px] font-bold tracking-wider text-[#8C6D52]">{month}</span>
    <span className="text-sm font-bold leading-4 text-[#23355d]">{day}</span>
  </div>
}

function NewsItem({ month, day, title, meta }: { month: string; day: string; title: string; meta: string }) {
  return <button type="button" className="flex items-center gap-3 rounded-lg px-2 py-2 text-left transition-colors hover:bg-slate-50">
    <DateTile month={month} day={day} />
    <div className="min-w-0 flex-1">
      <h3 className="truncate text-xs font-semibold text-slate-800">{title}</h3>
      <p className="truncate text-[10px] text-slate-400">{meta}</p>
    </div>
  </button>
}

function EventItem({ month, day, title, meta, tag, tone }: { month: string; day: string; title: string; meta: string; tag: string; tone: 'amber' | 'emerald' | 'blue' | 'bronze' }) {
  const tagStyles = { amber: 'border-amber-200 bg-amber-50 text-amber-700', emerald: 'border-emerald-200 bg-emerald-50 text-emerald-700', blue: 'border-blue-200 bg-blue-50 text-blue-700', bronze: 'border-[#D7C4B7] bg-[#F7F1EC] text-[#8C6D52]' }
  return <div className="flex items-center gap-3 rounded-lg px-2 py-2 transition-colors hover:bg-slate-50">
    <DateTile month={month} day={day} />
    <div className="min-w-0 flex-1">
      <h3 className="truncate text-xs font-semibold text-slate-800">{title}</h3>
      <p className="truncate text-[10px] text-slate-400">{meta}</p>
    </div>
    <Badge variant="outline" className={`shrink-0 rounded-full text-[9px] font-semibold ${tagStyles[tone]}`}>{tag}</Badge>
  </div>
}

function KpiCard({ icon: Icon, label, value, unit, note, accent }: { icon: typeof CalendarDays; label: string; value: string; unit: string; note: string; accent: 'blue' | 'bronze' | 'amber' }) {
  const colors = { blue: 'bg-blue-50 text-blue-600 ring-blue-100', bronze: 'bg-[#F7F1EC] text-[#8C6D52] ring-[#D7C4B7]/50', amber: 'bg-amber-50 text-amber-600 ring-amber-100' }
  return <Card className={`${cardSurface} transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:shadow-slate-200/70`}>
    <CardContent className="p-5">
      <div className="flex items-center justify-between">
        <p className="text-xs font-medium text-slate-500">{label}</p>
        <div className={`flex size-8 items-center justify-center rounded-lg ring-1 ${colors[accent]}`}><Icon className="size-4" /></div>
      </div>
      <p className="mt-3 flex items-baseline gap-1.5">
        <span className="text-[26px] font-bold leading-none tracking-tight text-[#192646] tabular-nums">{value}</span>
        <span className="text-xs font-medium text-slate-400">{unit}</span>
      </p>
      <Separator className="my-3.5 bg-slate-100" />
      <p className="text-[11px] text-slate-500">{note}</p>
    </CardContent>
  </Card>
}

function StatusBadge({ tone, label }: { tone: string; label: string }) {
  const styles = { approved: 'border-emerald-200 bg-emerald-50 text-emerald-700', pending: 'border-amber-200 bg-amber-50 text-amber-700', rejected: 'border-red-200 bg-red-50 text-red-700' }
  return <Badge variant="outline" className={`whitespace-nowrap rounded-full px-2 py-0.5 text-[10px] font-semibold ${styles[tone as keyof typeof styles]}`}><span className="mr-1 size-1.5 rounded-full bg-current" />{label}</Badge>
}

export default SbdDashboard
